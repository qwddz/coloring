<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: same exclusion for cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/drawings/"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/drawings/"/>
    </device-transfer>
</data-extraction-rules>
